<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_inherit_payment_wompicol" model="ir.ui.view">
        <field name="name">payment.provider.form.inherit.payment.wompicol</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr='//group[@name="provider_credentials"]' position='inside'>
                <group invisible="code != 'wompicol'">
                    <field name="wompicol_public_key"/>
                    <field name="wompicol_private_key" password="True"/>
                    <field name="wompicol_test_public_key"/>
                    <field name="wompicol_test_private_key" password="True"/>
                    <field name="wompicol_event_url"/>
                    <field name="wompicol_test_event_url"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
